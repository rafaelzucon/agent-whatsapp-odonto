# Copie para .env (./odonto.sh configurar faz isso e gera as chaves) e preencha.
# NUNCA versione o arquivo .env.

# ---------------- Consultório ----------------
CONSULTORIO_NOME=Consultório Odontológico Sorriso
CONSULTORIO_ENDERECO=Rua Exemplo, 123 - Centro - São Paulo/SP
CONSULTORIO_FUSO=America/Sao_Paulo
# Porta publicada no servidor (o contêiner escuta na 8080)
PORTA_HOST=8080

# ---------------- WhatsApp Cloud API (Meta) ----------------
WHATSAPP_VERSAO_API=v24.0
WHATSAPP_PHONE_NUMBER_ID=
# Token permanente de usuário do sistema (System User) com whatsapp_business_messaging
WHATSAPP_TOKEN_ACESSO=
# Texto livre que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_TOKEN_VERIFICACAO=
# Chave secreta do aplicativo (App Secret): valida a assinatura X-Hub-Signature-256
WHATSAPP_SEGREDO_APP=
# Número que recebe os avisos do consultório (DDI + DDD + número, só dígitos)
WHATSAPP_NUMERO_CONSULTORIO=
# true = avisos ao consultório por template aprovado (funciona fora da janela de 24h)
WHATSAPP_USAR_TEMPLATE=false
WHATSAPP_TEMPLATE_AGENDAMENTO=aviso_agendamento
WHATSAPP_TEMPLATE_ALERTA=alerta_atendimento
WHATSAPP_IDIOMA_TEMPLATE=pt_BR

# ---------------- IA ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-4-5
# Opcional: transcrição de áudios com Whisper. Sem chave, o agente pede que o paciente escreva.
OPENAI_API_KEY=
OPENAI_MODELO_TRANSCRICAO=whisper-1
# Confiança mínima (0 a 1) para aceitar a classificação da IA; abaixo disso, vale a de palavras-chave
IA_CONFIANCA_MINIMA=0.6

# ---------------- Agenda ----------------
AGENDA_DIAS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY
AGENDA_ABERTURA=08:00
AGENDA_FECHAMENTO=18:00
AGENDA_ALMOCO_INICIO=12:00
AGENDA_ALMOCO_FIM=13:00
AGENDA_DURACAO_CONSULTA=30m
AGENDA_ANTECEDENCIA_MINIMA=2h
# Datas AAAA-MM-DD separadas por vírgula
AGENDA_FERIADOS=2026-12-25,2027-01-01
AGENDA_DIAS_BUSCA=30

# ---------------- Conversa ----------------
CONVERSA_EXPIRACAO=2h
CONVERSA_MAX_TENTATIVAS=3
CONVERSA_CONFIRMAR_SUGESTAO=true

# ---------------- Segurança e LGPD ----------------
# Duas chaves DIFERENTES de 32 bytes em Base64: openssl rand -base64 32
# Guarde cópia segura: sem elas os dados criptografados não podem ser lidos.
CRIPTO_CHAVE_DADOS=
CRIPTO_CHAVE_HASH=
# Senha do PostgreSQL embutido (só acessível de dentro do contêiner)
DB_SENHA=
# Token da API administrativa (/api/admin). Vazio = API desligada.
ADMIN_TOKEN=
RETENCAO_MENSAGENS_DIAS=180
RETENCAO_CONVERSAS_DIAS=30

# ---------------- E-mail (opcional) ----------------
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
EMAIL_DESTINATARIOS=

# ---------------- Diversos ----------------
LOG_NIVEL=INFO
# JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
