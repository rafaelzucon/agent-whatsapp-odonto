# Parâmetros da implantação no AWS Lambda (sem segredos). Copie para aws/parametros.env com:
#   ./aws/implantar.sh configurar
# Formato CHAVE=valor, sem aspas. Linhas com # são comentários.

# ---- Implantação
# Nome da pilha do CloudFormation (prefixo de todos os recursos).
PILHA=agente-odonto
# Região da AWS (sa-east-1 = São Paulo).
REGIAO=sa-east-1
# Nome do segredo no Secrets Manager que guarda o conteúdo de aws/segredos.json.
NOME_SEGREDO=agente-odonto/segredos

# ---- Parâmetros do template (aws/template.yaml)
# Phone Number ID do número do consultório (painel da Meta > WhatsApp > Configuração da API).
WhatsAppPhoneNumberId=PREENCHA
# Número que recebe os avisos de agendamento (DDI + DDD + número, só dígitos).
WhatsAppNumeroConsultorio=PREENCHA
WhatsAppVersaoApi=v24.0
WhatsAppUsarTemplate=false
ConsultorioNome=Consultório Odontológico
ConsultorioEndereco=Rua Exemplo, 123 - Centro
AnthropicModelo=claude-haiku-4-5
# openai = transcreve áudios com o Whisper; none = pede que o paciente responda por texto.
TranscricaoProvedor=openai
ClasseInstanciaBanco=db.t4g.micro
ArmazenamentoBancoGb=20
ConcorrenciaConversa=5
HabilitarApiAdmin=true
DiasRetencaoLogs=30
